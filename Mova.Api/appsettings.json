{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=mova.db"
  },
  "Jwt": {
    "Key": "replace-with-a-long-random-secret-at-least-32-chars",
    "Issuer": "MovaApi",
    "Audience": "MovaApp",
    "ExpiryMinutes": 60
  }
}